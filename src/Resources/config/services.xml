<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <prototype namespace="Netlogix\ShopwareTranslationBridge\"
                   resource="../../*"
                   exclude="../../Resources"/>

        <service id="Netlogix\ShopwareTranslationBridge\Core\System\Snippet\TranslationProviderResolverInterface"
                 alias="Netlogix\ShopwareTranslationBridge\Core\System\Snippet\TranslationProviderResolver"/>
        <service id="Netlogix\ShopwareTranslationBridge\Core\System\Snippet\SalesChannelTranslationRefresherInterface"
                 alias="Netlogix\ShopwareTranslationBridge\Core\System\Snippet\SalesChannelTranslationRefresher"/>
        <service id="Netlogix\ShopwareTranslationBridge\Core\Framework\Adapter\Translator\TranslationCacheInvalidationInterface"
                 alias="Netlogix\ShopwareTranslationBridge\Core\Framework\Adapter\Translator\TranslationCacheInvalidation"/>
    </services>
</container>
