    v-if="providerName"
    class="nlx-translation-provider-notice"
    variant="info"
    :title="$tc('nlx-storefront-translation.nlx-translation-provider-notice.title')"
>
    {{ $tc('nlx-storefront-translation.nlx-translation-provider-notice.text', { provider: providerName }) }}
</mt-banner>
{% endblock %}
